# Copy to backend/.env (gitignored) and fill in.

# Required. Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional. Gemini model id (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Maximum specialist steps per request before the supervisor must finish (default: 6).
# MAX_STEPS=6

# Optional. User-Agent for external APIs. Nominatim's usage policy asks for one that identifies
# the application; add a contact address if you deploy this.
# HTTP_USER_AGENT="Navigatio.ai/0.1 (+https://github.com/giovannigiofre/Navigatio.ai)"
